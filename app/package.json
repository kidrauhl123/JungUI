{
  "name": "jungui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run registry:build && next dev --webpack",
    "build": "npm run registry:build && next build --webpack",
    "preview": "serve dist -l 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/check-registry.ts",
    "component:new": "tsx scripts/new-component.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run registry:check",
    "test:install": "tsx scripts/test-install.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.20.0",
    "motion": "^12.40.0",
    "next": "^16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "serve": "^14.2.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

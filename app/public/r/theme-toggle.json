{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-toggle",
  "title": "日夜切换",
  "description": "太阳与月亮通过旋转和缩放交替出现的主题按钮。",
  "dependencies": [
    "clsx@^2.1.1",
    "tailwind-merge@^3.6.0"
  ],
  "files": [
    {
      "path": "components/ui/theme-toggle.css",
      "content": ".jui-theme-toggle {\n  --radius: 26px;\n  position: relative;\n  width: 40px;\n  height: 40px;\n  border-radius: var(--radius);\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  padding: 0;\n  border: 0;\n  background: #f2f2f2;\n  color: hsl(0 0% 5%);\n  backdrop-filter: blur(4px);\n  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.jui-theme-toggle[data-theme=\"dark\"] {\n  background: hsl(201 16% 65% / 0.15);\n  color: hsl(0 0% 98%);\n}\n.jui-theme-toggle:hover {\n  transform: scale(1.02);\n}\n.jui-theme-toggle:active {\n  transform: scale(0.95);\n}\n.jui-theme-toggle:focus-visible {\n  outline: 2px solid #2f7bd4;\n  outline-offset: 3px;\n}\n.jui-theme-toggle .tt-icon {\n  grid-column: 1;\n  grid-row: 1;\n  width: 1.2rem;\n  height: 1.2rem;\n  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.jui-theme-toggle .tt-sun {\n  transform: rotate(0) scale(1);\n}\n.jui-theme-toggle .tt-moon {\n  transform: rotate(90deg) scale(0);\n}\n.jui-theme-toggle[data-theme=\"dark\"] .tt-sun {\n  transform: rotate(-90deg) scale(0);\n}\n.jui-theme-toggle[data-theme=\"dark\"] .tt-moon {\n  transform: rotate(0) scale(1);\n}\n@media (prefers-reduced-motion: reduce) {\n  .jui-theme-toggle,\n  .jui-theme-toggle .tt-icon {\n    transition: none;\n  }\n  .jui-theme-toggle:hover,\n  .jui-theme-toggle:active {\n    transform: none;\n  }\n}\n",
      "type": "registry:file",
      "target": "@ui/theme-toggle.css"
    },
    {
      "path": "components/ui/theme-toggle.tsx",

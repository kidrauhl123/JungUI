Color\"\n        />\n        <path d={SUN_RAYS} fill=\"currentColor\" />\n      </svg>\n      <svg\n        className=\"tt-icon tt-moon\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        aria-hidden=\"true\"\n      >\n        <path d={MOON} fill=\"currentColor\" />\n      </svg>\n    </button>\n  );\n}\n",
